<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GlobeStay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .globestay-navbar .globestay-nav-link {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }
        .globestay-navbar .globestay-nav-link i {
            margin-right: 0.5rem;
        }
        .globestay-search-container {
            position: relative;
            max-width: 32rem;
            width: 100%;
        }
        .globestay-search-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            pointer-events: none;
            z-index: 2;
        }
        .globestay-search-input {
            padding: 0.375rem 0.75rem 0.375rem 2.5rem;
            border-radius: 9999px;
        }

        .globestay-search-input {
            outline: none;
            box-shadow: none;
            border-radius: 9999px;
            padding: 0.375rem 0.75rem 0.375rem 2.5rem;
        }

        /* Add a custom black focus ring */
        .globestay-search-input:focus {
        outline: none;
        box-shadow: 0 0 0 1px black;
        }


        @media (max-width: 1199.98px) {
            .globestay-search-container {
                display: none;
            }
        }
        @media (max-width: 767.98px) {
            .globestay-nav-buttons .globestay-nav-link {
                font-size: 0.875rem;
                padding: 0.375rem 0.75rem;
            }
            .globestay-nav-buttons .globestay-nav-link i {
                margin-right: 0.25rem;
            }
        }
        @media (max-width: 575.98px) {
            #globestayLoginItem {
                display: none !important;
            }
        }
        .container {
            margin-top: 0rem !important;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-light bg-light globestay-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/listings">
                <i class="bi bi-globe me-2"></i>
                <span>GlobeStay</span>
            </a>
            
            <div class="globestay-search-container mx-auto">
                <i class="bi bi-search globestay-search-icon"></i>
                <input type="search" id="searchInput" class="form-control globestay-search-input" placeholder="Search for stays..." aria-label="Search">

            <!-- Live Results Container -->
            <div id="searchResults" class="list-group position-absolute w-100 mt-1" style="z-index: 10;"></div>

            </div>

            <ul class="navbar-nav d-flex flex-row globestay-nav-buttons">
                <li class="nav-item me-1 me-md-3">
                    <a class="nav-link globestay-nav-link" href="/listings/new">
                        <i class="bi bi-plus-circle"></i>
                        <span class="d-none d-sm-inline">Add New Listing</span>
                        <span class="d-inline d-sm-none">Add Listing</span>
                    </a>
                </li>
                <% if(!currUser){ %>
                <li class="nav-item me-1 me-md-3" id="globestaySignupItem">
                    <a class="nav-link globestay-nav-link" href="/signup">
                        <i class="bi bi-person-plus"></i>
                        Sign Up
                    </a>
                </li>
                <li class="nav-item me-1 me-md-3" id="globestayLoginItem">
                    <a class="nav-link globestay-nav-link" href="/login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Log In
                    </a>
                </li>
                <% } %>
                <% if(currUser){ %>
                <li class="nav-item me-1 me-md-3" id="globestayLogoutItem">
                    <a class="nav-link globestay-nav-link" href="/logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Log Out
                    </a>
                </li>
                <% } %>
            </ul>
        </div>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="script.js"></script>

</body>
</html>